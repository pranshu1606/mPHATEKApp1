# --- App ---
DATABASE_PATH="./data/app.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-output-of: openssl rand -base64 32"
SUPER_ADMIN_EMAIL="owner@example.com"

GITHUB_ID=""
GITHUB_SECRET=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI (Python backend) ---
GEMINI_API_KEY=""
GROQ_API_KEY=""            # optional fallback LLM

# --- Production only (docker-compose.prod.yml) ---
PUBLIC_URL=""              # https://<id>.cloudfront.net  (terraform output public_url)
ORIGIN_HOST=""             # terraform output origin_host (yourapp.duckdns.org)
ORIGIN_VERIFY_SECRET=""    # openssl rand -hex 32 — must match terraform.tfvars
ACME_EMAIL=""              # Let's Encrypt contact email
BACKUP_S3_URI=""           # optional: terraform output backup_s3_uri (s3://...)
